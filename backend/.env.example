# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret (generate a strong random string)
SECRET_KEY=your_secret_key_here

# xAI Grok API
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=llama-3.3-70b-versatile
 
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_WELCOME_TEMPLATE_ID=your_emailjs_welcome_template_id
VITE_EMAILJS_LOGIN_TEMPLATE_ID=your_emailjs_login_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Simulation (set to true to enable synthetic data generation)
ENABLE_SIMULATION=false
